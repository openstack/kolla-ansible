{
    "command": "/usr/sbin/pacemakerd -f",
    "config_files": [
        {
            "source": "{{ container_config_directory }}/authkey",
            "dest": "/etc/pacemaker/authkey",
            "owner": "hacluster:haclient",
            "perm": "0400"
        }
    ],
    "directories": [
        {
            "path": "/var/log/kolla",
            "owner": "fluentd:kolla",
            "perm": "2775"
        },
        {
            "path": "/var/log/kolla/hacluster",
            "owner": "hacluster:kolla",
            "perm": "2775"
        }
    ],
    "permissions": [
        {
            "path": "/var/log/kolla/hacluster/*.log",
            "owner": "hacluster:kolla",
            "perm": "0664"
        }
    ]
}
