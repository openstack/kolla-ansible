{% set pxe_dir = '/var/lib/ironic/tftpboot/pxelinux.cfg' %}
{% set pxe_cfg = 'default' %}
{
    "command": "/usr/sbin/in.tftpd --verbose --foreground --user nobody --address {{ ironic_tftp_listen_address }}:69 --map-file /map-file /var/lib/ironic/tftpboot",
    "config_files": [
{% for item in ironic_agent_files if not ironic_dnsmasq_serve_ipxe | bool and groups['ironic-dnsmasq'] | length > 0 %}
        {
            "source": "{{ container_config_directory }}/{{ item }}",
            "dest": "/var/lib/ironic/tftpboot/{{ item }}",
            "owner": "root",
            "perm": "0644"
        },
{% endfor %}
{% if not ironic_dnsmasq_serve_ipxe | bool and groups['ironic-dnsmasq'] | length > 0 %}
        {
            "source": "{{ container_config_directory }}/default",
            "dest": "{{ pxe_dir }}/{{ pxe_cfg }}",
            "owner": "root",
            "perm": "0644"
        }
{% endif %}
    ],
    "directories": [
        {
            "path": "/var/log/kolla",
            "owner": "fluentd:kolla",
            "perm": "2775"
        },
        {
            "path": "/var/log/kolla/ironic",
            "owner": "ironic:kolla",
            "perm": "2775"
        }
    ],
    "permissions": [
        {
            "path": "/var/log/kolla/ironic/*.log",
            "owner": "ironic:kolla",
            "perm": "0664"
        },
        {
            "path": "{{ pxe_dir }}",
            "owner": "ironic:ironic",
            "recurse": true
        }
    ]
}
