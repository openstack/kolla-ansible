{
    "command": "dnsmasq --no-daemon --conf-file=/etc/dnsmasq.conf",
    "config_files": [
        {
            "source": "{{ container_config_directory }}/dnsmasq.conf",
            "dest": "/etc/dnsmasq.conf",
            "owner": "root",
            "perm": "0600"
        }{% if kolla_copy_ca_into_containers | bool %},
        {
            "source": "{{ container_config_directory }}/ca-certificates",
            "dest": "/var/lib/kolla/share/ca-certificates",
            "owner": "root",
            "perm": "0644"
        }{% endif %}
    ],
    "directories": [
        {
            "path": "/var/log/kolla",
            "owner": "fluentd:kolla",
            "perm": "2775"
        },
        {
            "path": "/var/log/kolla/ironic",
            "owner": "ironic:kolla",
            "perm": "2775"
        }
    ],
    "files": [
        {
            "path": "/var/log/kolla/ironic/dnsmasq.log",
            "owner": "ironic:kolla",
            "perm": "0664"
        }
    ],
    "permissions": [
        {
            "path": "/var/log/kolla/ironic/*.log",
            "owner": "ironic:kolla",
            "perm": "0664"
        }
    ]
}
