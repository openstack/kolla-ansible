enable_keystone_federation: true
keystone_identity_providers:
  - name: "example_provider"
    openstack_domain: "Default"
    protocol: "openid"
    identifier: "https://idp.example.org/realms/example"
    public_name: "Example Provider"
    attribute_mapping: "sso_oidc_mapping"
    metadata_folder: "/etc/kolla/config/keystone-httpd/federation/oidc/metadata"
keystone_identity_mappings:
  - name: "sso_oidc_mapping"
    file: "/etc/kolla/config/keystone-httpd/federation/oidc/attribute_maps/attribute_mapping.json"
